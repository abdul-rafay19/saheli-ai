# Copy to .env (same folder as llm.py) for local use, or paste into Streamlit Cloud > Settings > Secrets.
# Format: KEY=value with no quotes and no spaces around '='. Never commit the real .env.
# Add at least a GEMINI_API_KEY (free at https://aistudio.google.com/apikey). Gemini does the thinking, the voice
# input (audio understanding) and the voice replies (Gemini TTS). Groq / NVIDIA are optional backups.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# PROVIDER_ORDER=gemini,groq,nvidia
# Optional model overrides (names change often, check each provider's docs):
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b
# Voice (all optional):
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore
# STT_ORDER=gemini,groq
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
