# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > Settings > Secrets.
# Add at least GEMINI_API_KEY (free at https://aistudio.google.com/apikey). Groq / NVIDIA are optional backups.
GEMINI_API_KEY = ""
GROQ_API_KEY = ""
NVIDIA_API_KEY = ""
# Optional: PROVIDER_ORDER = "gemini,groq,nvidia"
# Optional model overrides (names change often, check each provider's docs):
# GEMINI_MODEL = "gemini-flash-lite-latest"
# GROQ_MODEL = "openai/gpt-oss-120b"
# NVIDIA_MODEL = "meta/llama-3.3-70b-instruct"
# Voice (all optional):
# GEMINI_TTS_MODEL = "gemini-3.1-flash-tts-preview"
# GEMINI_TTS_VOICE = "Kore"
# STT_ORDER = "gemini,groq"
